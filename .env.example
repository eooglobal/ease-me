# Database Configuration
DATABASE_URL="postgresql://app_user:password@localhost:5432/ease_me"

# Authentication Secrets (Better Auth)
BETTER_AUTH_SECRET="development_secret_key_must_be_at_least_32_characters_long"
BETTER_AUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Paystack (Subscription Billing)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Cloudflare R2 (Receipts & File Storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ease-me-storage"
R2_PUBLIC_DOMAIN="https://pub-youraccount.r2.dev"

# Cache / Rate Limiting (Optional)
REDIS_URL="redis://localhost:6379"
